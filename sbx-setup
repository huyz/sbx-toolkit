#!/usr/bin/env bash
# sbx-setup — set up your local sandbox environment
#
# Think of this like applying your dotfiles, but for AI sandboxes.
# Run it once when setting up a new machine, or whenever you update
# your agent config (e.g. ~/.claude). Every project on this machine
# will use the resulting image.
#
# Usage:
#   ./sbx-setup [options]
#
# Options:
#   --template <name>        Template from templates/ to use (default: mise)
#   --dockerfile <path>      Custom Dockerfile (overrides --template)
#   --agent <variant>        Base image variant (default: claude-code)
#   --tag <image:tag>        Output image tag (auto-generated if omitted)
#   -c, --copy <src:dst>     Copy file/dir into image (repeatable, docker -v style)
#   --registry <host:port>   Registry to push to (default: localhost:8050)
#   --no-push                Build only, don't push to registry
#   --dry-run                Print what would happen without doing it
#   --help                   Show this help
set -euo pipefail

SCRIPT_DIR="$(cd "$(dirname "${BASH_SOURCE[0]}")" && pwd)"
DATA_DIR="${XDG_DATA_HOME:-$HOME/.local/share}/sbx-toolkit"

# ── defaults ──────────────────────────────────────────────────────────────────

TEMPLATE="mise"
DOCKERFILE=""
AGENT="claude-code"
TAG=""
COPY_SPECS=()
REGISTRY="localhost:8050"
NO_PUSH=false
DRY_RUN=false

# ── parse args ────────────────────────────────────────────────────────────────

while [[ $# -gt 0 ]]; do
	case "$1" in
	--template)
		TEMPLATE="$2"
		shift 2
		;;
	--dockerfile)
		DOCKERFILE="$2"
		shift 2
		;;
	--agent)
		AGENT="$2"
		shift 2
		;;
	--tag)
		TAG="$2"
		shift 2
		;;
	-c | --copy)
		COPY_SPECS+=("$2")
		shift 2
		;;
	--registry)
		REGISTRY="$2"
		shift 2
		;;
	--no-push)
		NO_PUSH=true
		shift
		;;
	--dry-run)
		DRY_RUN=true
		shift
		;;
	--help | -h)
		sed -n '2,/^set -euo pipefail/p' "$0" | grep '^#' | sed 's/^# \?//'
		exit 0
		;;
	*)
		echo "ERROR: Unknown flag: $1" >&2
		exit 1
		;;
	esac
done

# ── resolve dockerfile ────────────────────────────────────────────────────────

if [[ -n "$DOCKERFILE" ]]; then
	[[ -f "$DOCKERFILE" ]] || {
		echo "ERROR: Dockerfile not found: $DOCKERFILE" >&2
		exit 1
	}
	DOCKERFILE_PATH="$DOCKERFILE"
	TEMPLATE_LABEL="custom"
else
	if [[ -d "$SCRIPT_DIR/templates" ]]; then
		TEMPLATE_ROOT="$SCRIPT_DIR/templates"
	else
		TEMPLATE_ROOT="$DATA_DIR/templates"
	fi

	DOCKERFILE_PATH="$TEMPLATE_ROOT/${TEMPLATE}/Dockerfile"
	[[ -f "$DOCKERFILE_PATH" ]] || {
		echo "ERROR: Template '$TEMPLATE' not found at $DOCKERFILE_PATH" >&2
		echo "Available templates:" >&2
		for template_path in "$TEMPLATE_ROOT"/*; do
			template_name="$(basename "$template_path")"
			[[ "$template_name" == "README.md" ]] && continue
			echo "$template_name" >&2
		done
		echo "" >&2
		echo "If templates are missing, re-run install.sh to install them." >&2
		exit 1
	}
fi

# ── resolve tag ───────────────────────────────────────────────────────────────

if [[ -z "$TAG" ]]; then
	TEMPLATE_LABEL="${TEMPLATE_LABEL:-$TEMPLATE}"
	TAG="${REGISTRY}/sandbox-${TEMPLATE_LABEL}:${AGENT}"
fi

# ── ensure local registry is running ─────────────────────────────────────────

if [[ "$NO_PUSH" == false ]] && echo "$REGISTRY" | grep -qE '^localhost:'; then
	PORT="${REGISTRY#*:}"
	REGISTRY_CONTAINER=""

	if [[ "$DRY_RUN" == false ]]; then
		REGISTRY_CONTAINER="$(
			docker ps --filter "ancestor=registry:2" --filter "publish=${PORT}" \
				--format '{{.Names}}' | head -n 1
		)"
	fi

	if [[ -n "$REGISTRY_CONTAINER" ]]; then
		echo "→ Reusing local registry container $REGISTRY_CONTAINER on $REGISTRY"
	elif docker ps --filter "publish=${PORT}" --format '{{.Names}}' 2>/dev/null | grep -q .; then
		echo "ERROR: Port $PORT is already in use by a different container" >&2
		echo "       Stop the other container or choose a different --registry port" >&2
		exit 1
	else
		echo "→ Starting local registry at $REGISTRY"
		if [[ "$DRY_RUN" == false ]]; then
			docker run -d -p "${PORT}:5000" --restart always \
				--name local-registry registry:2 >/dev/null
		fi
	fi
fi

# ── build context ─────────────────────────────────────────────────────────────

BUILD_PARENT="${TMPDIR:-$SCRIPT_DIR/.tmp}"
mkdir -p "$BUILD_PARENT"
BUILD_DIR=$(mktemp -d "${BUILD_PARENT%/}/sbx-setup.XXXXXX")
trap 'rm -rf "$BUILD_DIR"' EXIT

cp "$DOCKERFILE_PATH" "$BUILD_DIR/Dockerfile"

COPY_RULES=()

# Copy additional files/directories into the build context.
# Syntax mirrors docker -v: source:target.
if [[ ${#COPY_SPECS[@]} -gt 0 ]]; then
	command -v rsync >/dev/null 2>&1 || {
		echo "ERROR: rsync is required for --copy (used to copy directories)." >&2
		echo "       Install it (e.g. 'brew install rsync' on macOS, 'apt install rsync' on Debian)." >&2
		exit 1
	}

	mkdir -p "$BUILD_DIR/copies"
	copy_idx=0

	for spec in "${COPY_SPECS[@]}"; do
		IFS=':' read -r raw_source target extra <<<"$spec"

		if [[ -z "${raw_source:-}" || -z "${target:-}" || -n "${extra:-}" ]]; then
			echo "ERROR: Invalid --copy value '$spec'. Expected source:target" >&2
			exit 1
		fi

		source_path="${raw_source/#\~/$HOME}"
		context_path="copies/item-${copy_idx}"

		if [[ -d "$source_path" ]]; then
			mkdir -p "$BUILD_DIR/$context_path"
			rsync -aL \
				--from0 \
				--exclude-from=<(
					cd "$source_path" &&
					find . -type l ! -exec test -e {} \; -print0 |
					perl -0pe 's{\A\./}{}'
				) \
				"$source_path/." "$BUILD_DIR/$context_path/"

			COPY_RULES+=("COPY --chown=agent:agent ${context_path}/ ${target}")
		elif [[ -f "$source_path" || -L "$source_path" ]]; then
			cp -L "$source_path" "$BUILD_DIR/$context_path"
			COPY_RULES+=("COPY --chown=agent:agent ${context_path} ${target}")
		else
			echo "WARNING: Copy source not found: $source_path — skipping --copy '$spec'" >&2
			continue
		fi

		copy_idx=$((copy_idx + 1))
	done
fi

if [[ ${#COPY_RULES[@]} -gt 0 ]]; then
	{
		echo ""
		echo "# Additional files injected by sbx-setup --copy"
		for rule in "${COPY_RULES[@]}"; do
			echo "$rule"
		done
	} >>"$BUILD_DIR/Dockerfile"
fi

# ── summary ───────────────────────────────────────────────────────────────────

echo "→ Setting up local sandbox environment"
echo "  template:      $DOCKERFILE_PATH"
echo "  agent:         $AGENT"
echo "  image tag:     $TAG"
if [[ ${#COPY_SPECS[@]} -gt 0 ]]; then
	echo "  copies:"
	for spec in "${COPY_SPECS[@]}"; do
		echo "    - $spec"
	done
else
	echo "  copies:        none"
fi
echo ""

if [[ "$DRY_RUN" == true ]]; then
	echo "docker build \\"
	echo "  --build-arg AGENT=$AGENT \\"
	echo "  -t $TAG \\"
	echo "  $BUILD_DIR"
	[[ "$NO_PUSH" == false ]] && echo "docker push $TAG"
	echo ""
	echo "Add this to your project's .sbx.toml:"
	echo "  template = \"$TAG\""
	echo ""
	echo "(dry run — not executing)"
	exit 0
fi

# ── build + push ──────────────────────────────────────────────────────────────

docker build \
	--build-arg AGENT="$AGENT" \
	-t "$TAG" \
	"$BUILD_DIR"

if [[ "$NO_PUSH" == false ]]; then
	echo "→ Installing to local registry ($REGISTRY)"
	docker push "$TAG"

	if echo "$REGISTRY" | grep -qE '^localhost:'; then
		sbx policy allow network "$REGISTRY" 2>/dev/null || true
	fi
fi

# ── done ──────────────────────────────────────────────────────────────────────

echo ""
echo "✓ Local sandbox environment ready"
echo ""
echo "Add this to your project's .sbx.toml:"
echo "  template = \"$TAG\""
echo ""
echo "Then start any project sandbox with:"
echo "  sbx-start"
