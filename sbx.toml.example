# .sbx.toml.example
# Copy this file to your project root as .sbx.toml and fill in the values.
# Commit .sbx.toml to your repo — everyone on the team will use the same settings.
#
# Run with: sbx-start
# Docs:     https://github.com/maxkrivich/sbx-toolkit

[sandbox]

# ── required ──────────────────────────────────────────────────────────────────

# The agent to run inside the sandbox.
# Options: claude, codex, kiro, shell, gemini, copilot, opencode
agent = "claude"

# The template image to use.
# Paste the exact image reference printed by sbx-setup.
# Tip: pin to a digest for reproducibility:
#   localhost:8050/sandbox-mise:claude-code@sha256:...
template = "localhost:8050/sandbox-mise:claude-code"

# ── network ───────────────────────────────────────────────────────────────────

# Base network policy.
# - allow-all:  all outbound traffic allowed
# - balanced:   common dev sites allowed (npm, PyPI, GitHub, etc.), rest blocked
# - deny-all:   everything blocked unless explicitly listed in allowed_domains
network_policy = "balanced"

# Extra domains to allow on top of the base policy.
# Use for internal APIs, private registries, or any host balanced mode blocks.
# allowed_domains = [
#   "registry.internal.example.com:443",
#   "api.internal.example.com:443",
# ]

# Domains to explicitly block, even if the base policy would allow them.
# blocked_domains = [
#   "example.com",
# ]

# ── git ───────────────────────────────────────────────────────────────────────

# Clone mode (for more security, as the agent can't touch git hooks, package.json,
# Makefile, IDE task configurations, CI workflows, etc.)
#
# TIP: see "include_untracked_files" to add on project files from host that are not in
# the git repo, e.g. .claude/, when enabling clone mode.
#
# - "enabled":    clones repo with the same ref (e.g. branch) as on the host
# - omit:         direct mode — agent edits your working tree directly
# clone = "enabled"

# ── untracked project files ───────────────────────────────────────────────────

# Additional directories to copy into the project repo.
# Useful when clone mode is enabled to add on project files from host that are
# not in the git repo, e.g. .claude/.
#
# NOTE: paths must be relative to the project root.
#
# include_untracked_files = [
#   ".env",
#   ".envrc",
#   ".claude",
# ]

# ── secrets ───────────────────────────────────────────────────────────────────

# Secret names required to run this sandbox.
# Values are NEVER stored here. sbx-start checks they exist and warns if missing.
# Set them once per machine with: sbx secret set <name>
# required_secrets = [
#   "ANTHROPIC_API_KEY",
#   "GITHUB_TOKEN",
# ]

# Custom secret mappings to inject into sandbox hosts.
# Each entry must be in the form: "ENV TARGET"
# Equivalent to having a .sbxrc call: sbx_secret_set ENV TARGET [ENV TARGET...]
# custom_secrets = [
#   "AWS_BEARER_TOKEN_BEDROCK bedrock-runtime.*.amazonaws.com",
#   "AWS_BEARER_TOKEN_BEDROCK bedrock.*.amazonaws.com",
# ]

# Environment variables to persist into every shell in the sandbox.
# Equivalent to having a .sbxrc call: sbx_persistent_env_vars <ENV...>
# imported_env_vars = [
#   "AWS_REGION",
# ]

# ── workspaces ────────────────────────────────────────────────────────────────

# Additional directories to mount into the sandbox (read-only).
# Useful for monorepos, shared docs, or design specs.
# extra_workspaces = [
#   "../shared-docs:ro",
# ]
