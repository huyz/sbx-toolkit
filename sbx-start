#!/usr/bin/env bash
# sbx-start — start a sandbox from .sbx.toml
# Install: curl -fsSL https://raw.githubusercontent.com/your-org/sbx-toolkit/main/install.sh | bash
set -euo pipefail

CONFIG_FILE=".sbx.toml"

# ── helpers ────────────────────────────────────────────────────────────────────

usage() {
	cat <<EOF
Usage: sbx-start [--force-recreate] [--dry-run|-n] [--help|-h]

Starts a sandbox using config from .sbx.toml in the current directory.

Options:
  --force-recreate  First delete the sandbox if it already exists
  --dry-run, -n   Print the sbx command without running it
  --help, -h      Show this help

Config file: .sbx.toml (committed to your project repo)
Docs:        https://github.com/maxkrivich/sbx-toolkit
EOF
	exit 0
}

die() {
	echo "ERROR: $*" >&2
	exit 1
}
warn() { echo "WARNING: $*" >&2; }

# Minimal TOML parser — reads key = "value" from flat keys (no section scoping)
toml_get() {
	local file="$1" key="$2"
	grep -E "^${key}\s*=" "$file" |
		head -1 |
		sed -E 's/^[^=]+=\s*//; s/\r$//; s/^[[:space:]]+//; s/[[:space:]]+$//; s/^"//; s/"$//'
}

# Extract items from a TOML array (multi-line or single-line)
# WARNING: filenames must not contain `]`
toml_get_array() {
	local file="$1" key="$2"
	awk -v key="$key" '
		$0 ~ "^[[:space:]]*" key "[[:space:]]*=" {
			found = 1
		}
		found {
			print
		}
		found && /[]]/ {
			found = 0
		}
	' "$file" |
			grep -oE '"[^"]+"' |
			tr -d '"'
}

# ── parse flags ────────────────────────────────────────────────────────────────

DRY_RUN=false
FORCE_RECREATE=false
for arg in "$@"; do
	case "$arg" in
	--dry-run | -n) DRY_RUN=false ;;
	--help | -h) usage ;;
	--force-recreate) FORCE_RECREATE=false ;;
	*) die "Unknown flag: $arg" ;;
	esac
done

# ── check config exists ────────────────────────────────────────────────────────

[[ -f "$CONFIG_FILE" ]] ||
	die "No $CONFIG_FILE found in $(pwd). Copy .sbx.toml.example from https://github.com/maxkrivich/sbx-toolkit"

# ── read config ────────────────────────────────────────────────────────────────

AGENT=$(toml_get "$CONFIG_FILE" "agent")
TEMPLATE=$(toml_get "$CONFIG_FILE" "template")
NETWORK_POLICY=$(toml_get "$CONFIG_FILE" "network_policy")
CLONE=$(toml_get "$CONFIG_FILE" "clone" || true)

[[ -n "$AGENT" ]] || die "Missing 'agent' in $CONFIG_FILE"
[[ -n "$TEMPLATE" ]] || die "Missing 'template' in $CONFIG_FILE"
[[ -n "$NETWORK_POLICY" ]] || NETWORK_POLICY="balanced"

# ── check sbx is installed ─────────────────────────────────────────────────────

command -v sbx >/dev/null 2>&1 ||
	die "'sbx' not found in PATH. Install from https://github.com/docker/sbx-releases"

# ── check required secrets ─────────────────────────────────────────────────────

MISSING_SECRETS=()
while IFS= read -r secret; do
	[[ -z "$secret" ]] && continue
	if ! sbx secret ls 2>/dev/null | grep -q "^${secret}$"; then
		MISSING_SECRETS+=("$secret")
	fi
done < <(toml_get_array "$CONFIG_FILE" "required_secrets")

if [[ ${#MISSING_SECRETS[@]} -gt 0 ]]; then
	warn "The following secrets are not set:"
	for s in "${MISSING_SECRETS[@]}"; do
		echo "  - $s  (run: sbx secret set $s)" >&2
	done
	echo "" >&2
fi

# ── apply base network policy ──────────────────────────────────────────────────

# The output of `sbx policy ls` no longer contains the base policy name, so we
# can't detect the current policy. Instead we always attempt `sbx policy init`
# with the requested policy; if it's already initialized, sbx errors out and we
# leave it unchanged.
#
# See: https://github.com/maxkrivich/sbx-toolkit/issues/3

# TODO: remove backward-compat for old policy names (open, locked-down)
case "$NETWORK_POLICY" in
open)        NETWORK_POLICY="allow-all" ;;
locked-down) NETWORK_POLICY="deny-all" ;;
esac

case "$NETWORK_POLICY" in
allow-all | balanced | deny-all) ;;
*) die "Unknown network_policy '$NETWORK_POLICY'. Use: allow-all, balanced, deny-all" ;;
esac

echo "→ Initializing network policy: $NETWORK_POLICY"
if [[ "$DRY_RUN" == false ]]; then
	if ! POLICY_OUTPUT="$(sbx policy init "$NETWORK_POLICY" 2>&1)"; then
		if grep -q 'already initialized' <<<"$POLICY_OUTPUT"; then
			echo "→ Network policy already initialized; leaving it unchanged"
		else
			echo "$POLICY_OUTPUT" >&2
			exit 1
		fi
	fi
fi

# ── apply custom network rules ─────────────────────────────────────────────────

while IFS= read -r domain; do
	[[ -z "$domain" ]] && continue
	echo "→ Allowing network: $domain"
	[[ "$DRY_RUN" == false ]] && sbx policy allow network "$domain"
done < <(toml_get_array "$CONFIG_FILE" "allowed_domains")

while IFS= read -r domain; do
	[[ -z "$domain" ]] && continue
	echo "→ Blocking network: $domain"
	[[ "$DRY_RUN" == false ]] && sbx policy block network "$domain"
done < <(toml_get_array "$CONFIG_FILE" "blocked_domains")

# ── sbx create command ────────────────────────────────────────────────────────

WORKDIR=$(basename "$(pwd)")
SANDBOX="$AGENT-$WORKDIR"

sandbox_exists=

# ── Utility functions (also callable from .sbxrc) ───────────────────────────

# Removes specified custom secret, if found, by its placeholder in the sandbox
sbx_secret_rm() {
	local SANDBOX=$1 env=$2 placeholder
	while IFS= read -r placeholder; do
		sbx secret rm -f "$SANDBOX" --placeholder "$placeholder" >/dev/null
	done < <(sbx secret ls "$SANDBOX" | awk -v env="$env" '
		$(NF - 2) == env { print $(NF - 1) }
	') # awk: we count columns from the right because the TARGET columns may have spaces
}

# Adds specified custom secrets
# Example:
# sbx_secret_set \
#   AWS_BEARER_TOKEN_BEDROCK "bedrock-runtime.$AWS_REGION.amazonaws.com" \
#   AWS_BEARER_TOKEN_BEDROCK "bedrock.$AWS_REGION.amazonaws.com" \
sbx_secret_set() {
	if (( $# % 2 != 0 )); then
		echo "${BASH_SOURCE[0]}: ERROR: sbx_secret_set expects ENV TARGET pairs" >&2
		exit 1
	fi

	local env host placeholder
	local -a all_args=("$@")
	local -a envs=()

	# Validate all env vars are set, and collect unique envs in order of first appearance.
	# (Avoids bash-4 associative arrays so this works on macOS's bash 3.2.)
	local i e seen
	for (( i = 0; i < ${#all_args[@]}; i += 2 )); do
		env="${all_args[$i]}"

		if [[ -z "${!env:-}" ]]; then
			echo "${BASH_SOURCE[0]}: ERROR: environment variable $env not found." >&2
			exit 1
		fi

		seen=0
		for e in "${envs[@]}"; do
			[[ "$e" == "$env" ]] && seen=1
		done
		[[ "$seen" == 0 ]] && envs+=("$env")
	done

	for env in "${envs[@]}"; do
		echo "🤐 Adding custom secret $env"
		sbx_secret_rm "$SANDBOX" "$env"
		# We use a stable placeholder so that we don't have to re-create the sandbox shells
		# if there's an update to the secret or to the hosts.
		placeholder="sbx-cs-$env-placeholder"

		local args=()
		for (( i = 0; i < ${#all_args[@]}; i += 2 )); do
			if [[ "${all_args[$i]}" == "$env" ]]; then
				args+=(--host "${all_args[$i + 1]}")
			fi
		done

		printf '%s' "${!env}" |
			sbx secret set-custom "$SANDBOX" \
				"${args[@]}" \
				--placeholder "$placeholder" \
				--env "$env" >/dev/null
		echo
	done
}

# Exports the specified environment variables to /etc/sandbox-persistent.sh
# to populate every shell in the sandbox
sbx_persistent_env_vars() {
	if [[ "$#" -eq 0 ]]; then
		echo "${FUNCNAME[0]}: ERROR: expected at least one environment variable name" >&2
		return 1
	fi

	local exports=""
	local var vars_hash block_start block_end

	# Use a stable hash so repeated calls with the same env-var set update in place.
	vars_hash="$(printf '%s\n' "$@" | LC_ALL=C sort -u | tr '\n' ',' | cksum | awk '{print $1}' | cut -c1-8)"
	# WARNING: block_start/block_end must not contain the following chars: " /
	block_start="# >>> sbx persistent env vars ${vars_hash}"
	block_end="# <<< sbx persistent env vars ${vars_hash}"

	for var in "$@"; do
		if [[ -z "${!var:-}" ]]; then
			echo "${FUNCNAME[0]}: ERROR: $var not found. Did you \`direnv allow\` at the host before running sbx-start?" >&2
			return 1
		fi

		exports+=$'\n'"  export $var=$(printf '%q' "${!var}")"
	done

	echo "💲 Appending persistent environment variables to /etc/sandbox-persistent.sh: $*"

	sbx exec -d "$SANDBOX" bash -s <<EOF
set -euo pipefail

persistent_file="/etc/sandbox-persistent.sh"

touch "\$persistent_file"

tmp_file="\$(mktemp)"
sed "/^${block_start}\$/,/^${block_end}\$/d" "\$persistent_file" > "\$tmp_file"
cat "\$tmp_file" > "\$persistent_file"
rm -f "\$tmp_file"

cat >> "\$persistent_file" <<EOF_PERSISTENT_ENV_VARS

${block_start}
# Prevent infinite recursion from subshells
if [[ -z "\\\$_SANDBOX_PERSISTENT_SH" ]]; then
  export _SANDBOX_PERSISTENT_SH=1
${exports}
fi
${block_end}
EOF_PERSISTENT_ENV_VARS
EOF
}

# If the sandbox exist, re-create if requested
if sbx ls -q | grep -Fqx "$SANDBOX"; then
	if [[ "$FORCE_RECREATE" == true ]]; then
		echo "→ Deleting existing sandbox $SANDBOX"
		sbx rm "$SANDBOX"
		echo
	else
		sandbox_exists=1
	fi
fi

if [[ -z "$sandbox_exists" ]]; then
	# If the sandbox doesn't yet exist, create it
	CREATE_CMD=(sbx create --name "$SANDBOX" --template "$TEMPLATE")

	[[ -n "$CLONE" ]] && CREATE_CMD+=(--clone)

	CREATE_CMD+=("$AGENT" ".")

	while IFS= read -r ws; do
		[[ -n "$ws" ]] && CREATE_CMD+=("$ws")
	done < <(toml_get_array "$CONFIG_FILE" "extra_workspaces")

	echo "→ Creating sandbox $SANDBOX"
	echo "  agent:           $AGENT"
	echo "  template:        $TEMPLATE"
	echo "  network policy:  $NETWORK_POLICY"
	echo "  clone:           ${CLONE:-disabled}"
	echo ""
	echo "  command: ${CREATE_CMD[*]}"
	echo ""

	if [[ "$DRY_RUN" == true ]]; then
		echo "(dry run — not executing)"
		echo "${CREATE_CMD[@]}"
	else
		"${CREATE_CMD[@]}"
	fi
	echo
fi

# ── Optionally, copy project files, untracked by git -─────────────────────────

while IFS= read -r untracked_file; do
	if [[ "$untracked_file" == /* ]]; then
		echo "ERROR: Project file/dir must be relative to project root. Skipping: $untracked_file" >&2
	else
		echo "➕ Copying extra project file/dir to sandbox: $untracked_file"

		if [[ "$DRY_RUN" == true ]]; then
			echo "(dry run — not executing)"
		else
			# NOTE: we have to read from </dev/null or sbx exec will suck the output of toml_get_array
			sbx exec "$SANDBOX" bash -lc '
				set -euo pipefail

				untracked_file=$1
				source_root=/run/sandbox/source
				src=$source_root/$untracked_file
				dst=$PWD/$untracked_file

				if [ ! -e "$src" ] && [ ! -L "$src" ]; then
					echo "ERROR: Source does not exist: $src" >&2
					exit 1
				fi

				if [ -d "$src" ] && [ ! -L "$src" ]; then
					mkdir -p "$dst"
					cp -a "$src"/. "$dst"/
				else
					mkdir -p "$(dirname "$dst")"
					cp -a "$src" "$dst"
				fi
			' bash "$untracked_file" </dev/null
		fi
	fi
done < <(toml_get_array "$CONFIG_FILE" "include_untracked_files" || true)
echo

# ── sbx run command ───────────────────────────────────────────────────────────
# ── Optionally, apply secrets from config ────────────────────────────────────

IMPORTED_SECRET_VARS=()
while IFS= read -r secret_env; do
	[[ -z "$secret_env" ]] && continue
	IMPORTED_SECRET_VARS+=("$secret_env")
done < <(toml_get_array "$CONFIG_FILE" "imported_env_vars" || true)

if [[ ${#IMPORTED_SECRET_VARS[@]} -gt 0 ]]; then
	echo "→ Importing persistent env vars: ${IMPORTED_SECRET_VARS[*]}"
	if [[ -n "$DRY_RUN" ]]; then
		echo "(dry run — not executing) sbx_persistent_env_vars ${IMPORTED_SECRET_VARS[*]}"
	else
		sbx_persistent_env_vars "${IMPORTED_SECRET_VARS[@]}"
	fi
	echo
fi

CUSTOM_SECRET_ARGS=()
while IFS= read -r custom_secret_entry; do
	[[ -z "$custom_secret_entry" ]] && continue

	if [[ "$custom_secret_entry" =~ ^([^[:space:]]+)[[:space:]]+(.+)$ ]]; then
		env_name="${BASH_REMATCH[1]}"
		target="${BASH_REMATCH[2]}"
		CUSTOM_SECRET_ARGS+=("$env_name" "$target")
	else
		die "Invalid custom_secrets entry '$custom_secret_entry'. Expected format: 'ENV TARGET'"
	fi
done < <(toml_get_array "$CONFIG_FILE" "custom_secrets" || true)

if [[ ${#CUSTOM_SECRET_ARGS[@]} -gt 0 ]]; then
	echo "→ Applying custom secrets from config"
	if [[ -n "$DRY_RUN" ]]; then
		echo "(dry run — not executing) sbx_secret_set ${CUSTOM_SECRET_ARGS[*]}"
	else
		sbx_secret_set "${CUSTOM_SECRET_ARGS[@]}"
	fi
	echo
fi
# ── sbx run command ──────────────────────────────────────────────────────

echo "→ Running sandbox $SANDBOX"
if [[ "$DRY_RUN" == true ]]; then
	echo "(dry run — not executing)"
	echo sbx run --name "$SANDBOX"
else
	exec sbx run --name "$SANDBOX"
fi
